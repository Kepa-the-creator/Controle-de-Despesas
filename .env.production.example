# Copie para .env.production na VPS e ajuste os valores.
# Usado pelo docker-compose.yml (docker compose --env-file .env.production up -d --build)

# --- Fase 1: sem domínio ainda ---
# URL pública do PocketBase, usada dentro do bundle do frontend (fica fixa no
# JS gerado no build, então precisa ser o endereço que o NAVEGADOR do usuário
# vai conseguir acessar — IP público da VPS, não localhost).
PUBLIC_POCKETBASE_URL=http://SEU_IP_DA_VPS:8090

# Versão do PocketBase a baixar no build da imagem (deve bater com a versão
# do SDK "pocketbase" em package.json, ou ser compatível com ela)
PB_VERSION=0.28.2

# --- Fase 2: depois que os nomes/DNS (ex: DuckDNS) apontarem para a VPS ---
# Preencha os dois hosts públicos e mude PUBLIC_POCKETBASE_URL para
# https://<PB_HOST>, depois suba com:
# docker compose --env-file .env.production --profile https up -d --build
FRONTEND_HOST=
PB_HOST=
